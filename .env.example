# Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Deployment ───────────────────────────────────────────────
# The full URL of your deployed site (no trailing slash).
# Used to generate correct QR codes. Without this, QR codes generated
# locally will point to localhost and be unusable when printed.
VITE_DEPLOYED_URL=https://your-app.vercel.app

# ── Demo / Development ────────────────────────────────────────
# The slug that shows sample data when navigating to /memorial/<slug>
# Change this if a real memorial with this slug exists in your database.
VITE_DEMO_SLUG=kofi-mensah
