# Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Deployment ───────────────────────────────────────────────
# The full URL of your deployed site (no trailing slash).
# Used to generate correct QR codes.
# For local development, you can leave this empty (falls back to window.location.origin).
VITE_DEPLOYED_URL=https://your-app.vercel.app
